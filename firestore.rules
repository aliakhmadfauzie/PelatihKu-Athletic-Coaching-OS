rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// 1. Collection: internal_auth
//    Document ID: {userId} or {doc} (User auth UID or internal auth identifier)
//    Description: Server-only credentials storage containing pinHash, salt, createdAt, updatedAt.
//    Fields:
//      - pinHash: string (required) - SHA-256 or bcrypt hashed PIN
//      - salt: string (required) - cryptographic salt
//      - createdAt: timestamp (required) - creation timestamp
//      - updatedAt: timestamp (required) - last update timestamp
//    Access: Completely blocked from all client-side operations (read, write, list, create, update, delete).
//            Only Cloud Functions / Firebase Admin SDK can access this collection.
//
// 2. Collection: users
//    Document ID: {userId} (matches user auth UID)
//    Description: User profiles for all roles (client, coach, admin) provisioned and maintained by system.
//    Fields:
//      - uid: string (required, 1..128 chars, immutable, matches document ID)
//      - phoneNumber: string (required, 8..20 chars, E.164 phone format)
//      - role: string (required, 'client' | 'coach' | 'admin', immutable on update)
//      - coachId: string (required, 1..128 chars, coach's UID or system ID, immutable on update)
//      - profile: map (required)
//          - displayName: string (required, 1..100 chars)
//          - avatarUrl: string (required, 0..500 chars, empty string or valid URL)
//      - mustChangePin: bool (required) - flag forcing client to update default PIN
//      - createdAt: timestamp (required, immutable on update)
//      - updatedAt: timestamp (required, update timestamp)
//    Access:
//      - Read: Authenticated owner or coach/admin (isOwner(userId) || isCoachOrAdmin())
//      - Create: Authenticated coaches or admins with custom claims (role == 'coach' || role == 'admin')
//      - Update: Authenticated owner or coach/admin, with immutable fields preserved ('uid', 'role', 'coachId', 'createdAt')
//      - Delete: Admin only (isAdmin())
//
// 3. Collection: clients
//    Document ID: {clientId} (e.g., 'k-01', 'k-1730812345678')
//    Description: Athletic coaching member profiles, biometrics, body fat %, PR records, session histories, schedules.
//    Fields:
//      - id: string (optional, 1..128 chars, matches document ID)
//      - code: string (optional, 1..50 chars, e.g. '#KLN-2024-082')
//      - nama_lengkap: string (optional, 1..200 chars)
//      - gender: string (optional, e.g. 'Pria' | 'Wanita')
//      - usia: number (optional)
//      - telepon: string (optional, 1..50 chars)
//      - target_utama: string (optional, 1..300 chars)
//      - target_category: string (optional)
//      - status: string (optional, e.g. 'Aktif' | 'Cuti')
//      - paketTotal: number (optional)
//      - paketTerpakai: number (optional)
//      - berat_awal_kg: number (optional, 0..500)
//      - berat_terkini_kg: number (optional, 0..500)
//      - berat_target_kg: number (optional, 0..500)
//      - body_fat_awal_pct: number (optional, 0..100)
//      - body_fat_terkini_pct: number (optional, 0..100)
//      - massa_otot_awal_kg: number (optional, 0..300)
//      - massa_otot_terkini_kg: number (optional, 0..300)
//      - visceralFatScore: number (optional, 0..50)
//      - lingkar_pinggang_awal_cm: number (optional, 0..300)
//      - lingkar_pinggang_terkini_cm: number (optional, 0..300)
//      - lingkar_dada_awal_cm: number (optional, 0..300)
//      - lingkar_dada_terkini_cm: number (optional, 0..300)
//      - lingkar_lengan_awal_cm: number (optional, 0..300)
//      - lingkar_lengan_terkini_cm: number (optional, 0..300)
//      - nextSession: map (optional)
//      - weeklyTrend: list (optional)
//      - prList: list (optional)
//      - sessions: list (optional)
//      - photos: list (optional)
//      - clientPin: string (optional, 1..50 chars)
//      - mustChangePin: bool (optional)
//      - pinChangedAt: string or timestamp (optional)
//      - pinChangeHistory: list (optional, max 100 entries)
//      - updatedAt: string or timestamp (optional)
//    Access:
//      - Read: Authorized coach, admin, or client owner (request.auth.uid == clientId or request.auth.token.clientId == clientId).
//      - Create & Delete: Authorized coaches or admins only.
//      - Update: Authorized coaches/admins, or client owner with restricted fields (client owner cannot modify
//                paketTotal, paketTerpakai, code, status, leadCoach, medicalHistoryNote, sessions, prList, berat_awal_kg,
//                lingkar_pinggang_awal_cm, lingkar_dada_awal_cm, lingkar_lengan_awal_cm, massa_otot_awal_kg, body_fat_awal_pct,
//                weeklyTrend, visceralFatScore, massa_otot_terkini_kg).
//                Client owner is permitted to update PIN credentials (clientPin, mustChangePin, pinChangedAt, pinChangeHistory).
//
// 4. Collection: coach_profile
//    Document ID: {profileId} (e.g., 'pas_profile')
//    Description: Head Coach profile settings, credentials, Kemenpora ID, gym locations, certifications.
//    Fields:
//      - name: string (optional, 1..200 chars)
//      - email: string (optional, 1..150 chars)
//      - kemenporaId: string (optional, 1..100 chars)
//      - pabsiLicense: string (optional, 1..100 chars)
//      - whatsapp: string (optional, 1..50 chars)
//      - primaryLocation: string (optional, 1..100 chars)
//      - certifications: list (optional)
//      - updatedAt: string or timestamp (optional)
//    Access:
//      - Read: Public / authenticated for gym branding, trainer verification, and dashboard display.
//      - Write (Create, Update, Delete): Authorized coach or admin only.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the caller has coach or admin authority via custom claims
    function isCoachOrAdmin() {
      return isAuthenticated() &&
        'role' in request.auth.token &&
        (request.auth.token.role == 'coach' || request.auth.token.role == 'admin');
    }

    // Check if the caller has admin authority via custom claims
    function isAdmin() {
      return isAuthenticated() &&
        'role' in request.auth.token &&
        request.auth.token.role == 'admin';
    }

    // Check if the caller is the client owner (by auth UID or custom token clientId claim)
    function isClientOwner(clientId) {
      return isAuthenticated() && (
        request.auth.uid == clientId ||
        ('clientId' in request.auth.token && request.auth.token.clientId == clientId)
      );
    }

    // Verify document contains all required fields
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Verify document contains ONLY allowed fields (strict schema enforcement)
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate that immutable fields have not been modified during update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Ensure client owner cannot modify restricted fields on client profile update
    // Baseline protection invariant: baseline physical measurements, calibration matrix, and quotas cannot be manipulated by client
    function clientOwnerRestrictedFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'id',
        'paketTotal',
        'paketTerpakai',
        'code',
        'status',
        'leadCoach',
        'medicalHistoryNote',
        'sessions',
        'prList',
        'berat_awal_kg',
        'lingkar_pinggang_awal_cm',
        'lingkar_dada_awal_cm',
        'lingkar_lengan_awal_cm',
        'massa_otot_awal_kg',
        'body_fat_awal_pct',
        'weeklyTrend',
        'visceralFatScore',
        'massa_otot_terkini_kg'
      ]);
    }

    // Validate web/storage URL format
    function isValidUrl(url) {
      return url is string &&
        (url.matches('^https://.*') || url.matches('^http://.*'));
    }

    // Validate international phone number format (E.164 pattern: + followed by digits, or local digits)
    function isValidPhoneNumber(phone) {
      return phone is string &&
        phone.size() >= 8 &&
        phone.size() <= 20 &&
        phone.matches('^\\+?[0-9]{8,20}$');
    }

    // ===============================================================
    // Domain Validators (Validator Function Pattern)
    // Mandatory: Must be invoked on BOTH create and update operations
    // ===============================================================

    function isValidProfile(profile) {
      return profile is map &&
        profile.keys().hasOnly(['displayName', 'avatarUrl']) &&
        profile.keys().hasAll(['displayName', 'avatarUrl']) &&
        profile.displayName is string &&
        profile.displayName.size() >= 1 &&
        profile.displayName.size() <= 100 &&
        profile.avatarUrl is string &&
        profile.avatarUrl.size() <= 500 &&
        (profile.avatarUrl == '' || isValidUrl(profile.avatarUrl));
    }

    function isValidUser(data) {
      return hasOnlyAllowedFields(['uid', 'phoneNumber', 'role', 'coachId', 'profile', 'mustChangePin', 'createdAt', 'updatedAt']) &&
        hasRequiredFields(['uid', 'phoneNumber', 'role', 'coachId', 'profile', 'mustChangePin', 'createdAt', 'updatedAt']) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        isValidPhoneNumber(data.phoneNumber) &&
        data.role is string &&
        (data.role == 'client' || data.role == 'coach' || data.role == 'admin') &&
        data.coachId is string &&
        data.coachId.size() >= 1 &&
        data.coachId.size() <= 128 &&
        isValidProfile(data.profile) &&
        data.mustChangePin is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validates structure, data types, and bounded sizes for client documents
    function isValidClient(data, clientId) {
      return (!('id' in data) || (data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id == clientId)) &&
             (!('code' in data) || (data.code is string && data.code.size() <= 50)) &&
             (!('nama_lengkap' in data) || (data.nama_lengkap is string && data.nama_lengkap.size() >= 1 && data.nama_lengkap.size() <= 200)) &&
             (!('gender' in data) || (data.gender is string && data.gender.size() <= 20)) &&
             (!('usia' in data) || (data.usia is number && data.usia >= 0 && data.usia <= 150)) &&
             (!('telepon' in data) || (data.telepon is string && data.telepon.size() <= 50)) &&
             (!('target_utama' in data) || (data.target_utama is string && data.target_utama.size() <= 300)) &&
             (!('target_category' in data) || (data.target_category is string && data.target_category.size() <= 50)) &&
             (!('phase' in data) || (data.phase is string && data.phase.size() <= 100)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             (!('leadCoach' in data) || (data.leadCoach is string && data.leadCoach.size() <= 100)) &&
             (!('paketTotal' in data) || (data.paketTotal is number && data.paketTotal >= 0 && data.paketTotal <= 1000)) &&
             (!('paketTerpakai' in data) || (data.paketTerpakai is number && data.paketTerpakai >= 0 && data.paketTerpakai <= 1000)) &&
             (!('dietCompliancePct' in data) || (data.dietCompliancePct is number && data.dietCompliancePct >= 0 && data.dietCompliancePct <= 100)) &&
             (!('berat_awal_kg' in data) || (data.berat_awal_kg is number && data.berat_awal_kg >= 0 && data.berat_awal_kg <= 500)) &&
             (!('berat_terkini_kg' in data) || (data.berat_terkini_kg is number && data.berat_terkini_kg >= 0 && data.berat_terkini_kg <= 500)) &&
             (!('berat_target_kg' in data) || (data.berat_target_kg is number && data.berat_target_kg >= 0 && data.berat_target_kg <= 500)) &&
             (!('body_fat_awal_pct' in data) || (data.body_fat_awal_pct is number && data.body_fat_awal_pct >= 0 && data.body_fat_awal_pct <= 100)) &&
             (!('body_fat_terkini_pct' in data) || (data.body_fat_terkini_pct is number && data.body_fat_terkini_pct >= 0 && data.body_fat_terkini_pct <= 100)) &&
             (!('massa_otot_awal_kg' in data) || (data.massa_otot_awal_kg is number && data.massa_otot_awal_kg >= 0 && data.massa_otot_awal_kg <= 300)) &&
             (!('massa_otot_terkini_kg' in data) || (data.massa_otot_terkini_kg is number && data.massa_otot_terkini_kg >= 0 && data.massa_otot_terkini_kg <= 300)) &&
             (!('visceralFatScore' in data) || (data.visceralFatScore is number && data.visceralFatScore >= 0 && data.visceralFatScore <= 50)) &&
             (!('lingkar_pinggang_awal_cm' in data) || (data.lingkar_pinggang_awal_cm is number && data.lingkar_pinggang_awal_cm >= 0 && data.lingkar_pinggang_awal_cm <= 300)) &&
             (!('lingkar_pinggang_terkini_cm' in data) || (data.lingkar_pinggang_terkini_cm is number && data.lingkar_pinggang_terkini_cm >= 0 && data.lingkar_pinggang_terkini_cm <= 300)) &&
             (!('lingkar_dada_awal_cm' in data) || (data.lingkar_dada_awal_cm is number && data.lingkar_dada_awal_cm >= 0 && data.lingkar_dada_awal_cm <= 300)) &&
             (!('lingkar_dada_terkini_cm' in data) || (data.lingkar_dada_terkini_cm is number && data.lingkar_dada_terkini_cm >= 0 && data.lingkar_dada_terkini_cm <= 300)) &&
             (!('lingkar_lengan_awal_cm' in data) || (data.lingkar_lengan_awal_cm is number && data.lingkar_lengan_awal_cm >= 0 && data.lingkar_lengan_awal_cm <= 300)) &&
             (!('lingkar_lengan_terkini_cm' in data) || (data.lingkar_lengan_terkini_cm is number && data.lingkar_lengan_terkini_cm >= 0 && data.lingkar_lengan_terkini_cm <= 300)) &&
             (!('medicalHistoryNote' in data) || (data.medicalHistoryNote is string && data.medicalHistoryNote.size() <= 3000)) &&
             (!('postureScreeningNote' in data) || (data.postureScreeningNote is string && data.postureScreeningNote.size() <= 3000)) &&
             (!('nutritionCoachNote' in data) || (data.nutritionCoachNote is string && data.nutritionCoachNote.size() <= 3000)) &&
             (!('nextSession' in data) || data.nextSession is map) &&
             (!('weeklyTrend' in data) || (data.weeklyTrend is list && data.weeklyTrend.size() <= 200)) &&
             (!('prList' in data) || (data.prList is list && data.prList.size() <= 500)) &&
             (!('sessions' in data) || (data.sessions is list && data.sessions.size() <= 1000)) &&
             (!('photos' in data) || (data.photos is list && data.photos.size() <= 200)) &&
             (!('clientPin' in data) || (data.clientPin is string && data.clientPin.size() <= 50)) &&
             (!('mustChangePin' in data) || data.mustChangePin is bool) &&
             (!('pinChangedAt' in data) || (data.pinChangedAt is string && data.pinChangedAt.size() <= 50) || data.pinChangedAt is timestamp) &&
             (!('pinChangeHistory' in data) || (data.pinChangeHistory is list && data.pinChangeHistory.size() <= 100));
    }

    // Validates essential structure and bounded size for coach profile documents
    function isValidCoachProfile(data) {
      return (!('name' in data) || (data.name is string && data.name.size() >= 1 && data.name.size() <= 200)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 50)) &&
             (!('kemenporaId' in data) || (data.kemenporaId is string && data.kemenporaId.size() <= 100)) &&
             (!('pabsiLicense' in data) || (data.pabsiLicense is string && data.pabsiLicense.size() <= 100)) &&
             (!('primaryLocation' in data) || (data.primaryLocation is string && data.primaryLocation.size() <= 100)) &&
             (!('specialization' in data) || (data.specialization is string && data.specialization.size() <= 200)) &&
             (!('certifications' in data) || (data.certifications is list && data.certifications.size() <= 50));
    }

    // ===============================================================
    // Security Invariant: Default Deny Root Fallback
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Collection 1: internal_auth/{doc}
    // Server-only credentials storage (pinHash, salt, createdAt, updatedAt)
    // Completely blocked from all client-side read/write/delete operations
    // ===============================================================
    match /internal_auth/{doc} {
      allow read, write: if false;
    }

    // ===============================================================
    // Collection 2: users/{userId}
    // User records managed by PelatihKu PRO OS (client, coach, admin)
    // ===============================================================
    match /users/{userId} {
      // Read: Allowed if the user is the account owner or if the caller is coach/admin (gym directory & audit)
      allow read: if isOwner(userId) || isCoachOrAdmin();

      // Create: Only authenticated users with custom claim 'coach' or 'admin' can provision user records
      allow create: if isCoachOrAdmin() &&
                       isValidUser(request.resource.data) &&
                       request.resource.data.uid == userId;

      // Update: Allowed for account owner or coach/admin.
      // Privilege escalation protection: callers cannot alter uid, role, coachId, or createdAt.
      allow update: if (isOwner(userId) || isCoachOrAdmin()) &&
                       isValidUser(request.resource.data) &&
                       request.resource.data.uid == resource.data.uid &&
                       areImmutableFieldsUnchanged(['uid', 'role', 'coachId', 'createdAt']);

      // Delete: Allowed for admin only
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Collection 3: clients/{clientId}
    // Member profiles, biometrics, PR records, sessions, and schedules
    // ===============================================================
    match /clients/{clientId} {
      // Read: Allowed for coach, admin, or the client owner
      allow read: if isCoachOrAdmin() || isClientOwner(clientId);

      // Create: Allowed for coach or admin with data shape validation
      allow create: if isCoachOrAdmin() &&
                       isValidClient(request.resource.data, clientId);

      // Update: Allowed for coach/admin or client owner with restricted field protection
      allow update: if isValidClient(request.resource.data, clientId) && (
        isCoachOrAdmin() ||
        (isClientOwner(clientId) && clientOwnerRestrictedFieldsUnchanged())
      );

      // Delete: Allowed for coach or admin only
      allow delete: if isCoachOrAdmin();
    }

    // ===============================================================
    // Collection 4: coach_profile/{profileId}
    // Head Coach profile, credentials, Kemenpora ID, and gym location settings
    // ===============================================================
    match /coach_profile/{profileId} {
      // Read: Allowed for public gym branding, verified credentials, and client dashboard
      allow read: if true;

      // Create: Allowed for coach or admin with shape validation
      allow create: if isCoachOrAdmin() &&
                       isValidCoachProfile(request.resource.data);

      // Update: Allowed for coach or admin with shape validation
      allow update: if isCoachOrAdmin() &&
                       isValidCoachProfile(request.resource.data);

      // Delete: Allowed for coach or admin
      allow delete: if isCoachOrAdmin();
    }
  }
}
